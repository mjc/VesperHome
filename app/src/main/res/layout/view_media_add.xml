<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="46dp"
            android:layout_height="42dp"
            android:contentDescription="@android:string/cancel"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            app:icon="@drawable/ic_previous"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="18dp" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="24sp" />

        <ProgressBar
            android:id="@+id/addProgress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="10dp"
            android:visibility="gone" />

    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/form"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/mediaSummary"
            android:layout_width="250dp"
            android:layout_height="0dp"
            android:baselineAligned="false"
            android:orientation="vertical"
            android:paddingStart="0dp"
            android:paddingEnd="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/poster"
                android:layout_width="200dp"
                android:layout_height="300dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/provider"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:tag="accent"
                android:textColor="@color/accent"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/overview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="6"
                android:tag="secondary"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

        <ScrollView
            android:id="@+id/optionsScroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/mediaSummary"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="0dp"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/media_root_folder"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rootFolder"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical|start"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textColor="@color/action_button_text"
                    app:cornerRadius="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/media_monitor"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/monitor"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical|start"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textColor="@color/action_button_text"
                    app:cornerRadius="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/media_quality_profile"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/qualityProfile"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical|start"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textColor="@color/action_button_text"
                    app:cornerRadius="8dp" />

                <LinearLayout
                    android:id="@+id/seriesOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/media_series_type"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/seriesType"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:gravity="center_vertical|start"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:textColor="@color/action_button_text"
                        app:cornerRadius="8dp" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/seasonFolder"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:text="@string/media_season_folder"
                        android:textColor="@color/text_primary" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/movieOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/media_minimum_availability"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/minimumAvailability"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:gravity="center_vertical|start"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:textColor="@color/action_button_text"
                        app:cornerRadius="8dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/media_tags"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tags"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical|start"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textColor="@color/action_button_text"
                    app:cornerRadius="8dp" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/searchMissing"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/searchCutoff"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="@string/media_search_cutoff_episodes"
                    android:textColor="@color/text_primary" />

            </LinearLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/add"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_gravity="end"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingHorizontal="24dp"
        android:text="@string/media_add_button"
        android:textColor="@color/action_button_text"
        app:cornerRadius="9dp"
        app:icon="@drawable/ic_add"
        app:iconPadding="9dp"
        app:iconSize="18dp" />

</LinearLayout>
