<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_background"
    android:orientation="vertical"
    android:paddingStart="56dp"
    android:paddingTop="44dp"
    android:paddingEnd="0dp"
    android:paddingBottom="36dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openLauncherSettings"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:backgroundTint="@color/action_button_background"
            android:contentDescription="@string/open_launcher_settings"
            android:text="@string/launcher_settings"
            android:textColor="@color/action_button_text"
            app:cornerRadius="10dp" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.Material3.DisplaySmall"
            android:textColor="@color/text_primary" />

    </LinearLayout>

    <ViewStub
        android:id="@+id/launcherContentStub"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_weight="1"
        android:inflatedId="@+id/launcherContent"
        android:layout="@layout/view_launcher_content" />

</LinearLayout>
