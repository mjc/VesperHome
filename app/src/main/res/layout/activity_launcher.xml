<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_background">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingTop="44dp"
        android:paddingEnd="0dp"
        android:paddingBottom="36dp">

        <LinearLayout
            android:id="@+id/statusBar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openLauncherSettings"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:backgroundTint="@color/action_button_background"
                android:contentDescription="@string/open_launcher_settings"
                android:text="@string/launcher_settings"
                android:textColor="@color/action_button_text"
                app:cornerRadius="10dp" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.Material3.DisplaySmall"
                android:textColor="@color/text_primary" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/statusInputs"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:backgroundTint="@color/action_button_background"
                android:contentDescription="@string/open_input_sources"
                android:textColor="@color/action_button_text"
                android:visibility="gone"
                app:cornerRadius="10dp" />

            <FrameLayout
                android:id="@+id/statusNotificationsContainer"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginEnd="10dp"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/statusNotifications"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_gravity="center_vertical"
                    android:backgroundTint="@color/action_button_background"
                    android:contentDescription="@string/open_notifications"
                    android:text="@string/notifications"
                    android:textColor="@color/action_button_text"
                    app:cornerRadius="10dp" />

                <TextView
                    android:id="@+id/statusNotificationBadge"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/notification_badge_background"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </FrameLayout>

            <TextView
                android:id="@+id/statusDateTime"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/home_status_background"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/text_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/statusNetwork"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="56dp"
                android:backgroundTint="@color/action_button_background"
                android:contentDescription="@string/open_wifi_settings"
                android:textColor="@color/action_button_text"
                app:cornerRadius="10dp" />

        </LinearLayout>

        <ViewStub
            android:id="@+id/launcherContentStub"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:layout_weight="1"
            android:inflatedId="@+id/launcherContent"
            android:layout="@layout/view_launcher_content" />

    </LinearLayout>

</FrameLayout>
