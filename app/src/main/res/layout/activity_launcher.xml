<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_background">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="26dp"
        android:paddingEnd="0dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/statusBar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openLauncherSettings"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:backgroundTint="@color/action_button_background"
                android:contentDescription="@string/open_launcher_settings"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_settings"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="18dp"
                app:iconTint="@color/action_button_text" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.24"
                android:text="@string/app_name"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/statusInputs"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/action_button_background"
                android:contentDescription="@string/open_input_sources"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:visibility="gone"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_input"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="18dp"
                app:iconTint="@color/action_button_text" />

            <FrameLayout
                android:id="@+id/statusNotificationsContainer"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/statusNotifications"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center_vertical"
                    android:backgroundTint="@color/action_button_background"
                    android:contentDescription="@string/open_notifications"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_bell"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/action_button_text" />

                <TextView
                    android:id="@+id/statusNotificationBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="17dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/notification_badge_background"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:minWidth="17dp"
                    android:paddingHorizontal="4dp"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:visibility="gone" />

            </FrameLayout>

            <TextView
                android:id="@+id/statusDateTime"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:fontFamily="sans-serif-condensed"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:paddingHorizontal="10dp"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/statusNetwork"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="48dp"
                android:backgroundTint="@color/action_button_background"
                android:contentDescription="@string/open_wifi_settings"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_wifi_4"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="18dp"
                app:iconTint="@color/action_button_text" />

        </LinearLayout>

        <ViewStub
            android:id="@+id/launcherContentStub"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="18dp"
            android:layout_weight="1"
            android:inflatedId="@+id/launcherContent"
            android:layout="@layout/view_launcher_content" />

    </LinearLayout>

</FrameLayout>
