<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_background"
    android:paddingStart="56dp"
    android:paddingTop="44dp"
    android:paddingEnd="0dp"
    android:paddingBottom="44dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textAppearance="@style/TextAppearance.Material3.DisplaySmall"
        android:textColor="@color/text_primary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/appsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="52dp"
        android:text="@string/applications"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
        android:textColor="@color/text_primary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title" />

    <TextView
        android:id="@+id/appCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
        android:textColor="@color/text_secondary"
        app:layout_constraintBaseline_toBaselineOf="@id/appsTitle"
        app:layout_constraintStart_toEndOf="@id/appsTitle" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/apps"
        android:layout_width="0dp"
        android:layout_height="190dp"
        android:layout_marginTop="18dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:focusable="false"
        android:overScrollMode="never"
        android:paddingStart="8dp"
        android:paddingEnd="56dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appsTitle" />

</androidx.constraintlayout.widget.ConstraintLayout>
