<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/jellyfinPanel"
            android:layout_width="match_parent"
            android:layout_height="132dp"
            android:layout_marginEnd="56dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/home_status_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:id="@+id/musicArtwork"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:contentDescription="@string/music_artwork"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="18dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/musicTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/jellyfin_music"
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/musicArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/jellyfin_not_connected"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textColor="@color/text_secondary" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/musicLoading"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginHorizontal="12dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/musicPlayPause"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:backgroundTint="@color/action_button_background"
                android:text="@string/play"
                android:textColor="@color/action_button_text"
                android:visibility="gone"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/musicNext"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:backgroundTint="@color/action_button_background"
                android:text="@string/random_next"
                android:textColor="@color/action_button_text"
                android:visibility="gone"
                app:cornerRadius="10dp" />

        </LinearLayout>

        <com.sergioasenjo.ltvlauncher.applications.AppRowView
            android:id="@+id/favoriteRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/categoryRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical" />

        <com.sergioasenjo.ltvlauncher.applications.AppRowView
            android:id="@+id/tvRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.sergioasenjo.ltvlauncher.applications.AppRowView
            android:id="@+id/nonTvRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>
