<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:scrollbars="none">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/contentRows"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:focusable="false"
        android:overScrollMode="never" />

    <!-- The renderer moves these bound controls into full-width RecyclerView items. -->
    <LinearLayout
        android:id="@+id/contentTemplates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/jellyfinPanel"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginEnd="48dp"
            android:layout_marginBottom="@dimen/launcher_section_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/musicArtwork"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@color/action_button_background"
                android:contentDescription="@string/music_artwork"
                android:focusable="false"
                android:padding="9dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/musicTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:maxWidth="420dp"
                    android:text="@string/jellyfin_music"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/musicArtist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:maxWidth="420dp"
                    android:text="@string/jellyfin_not_connected"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/musicLoading"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="12dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/musicLibrary"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="14dp"
                android:backgroundTint="@color/action_button_background"
                android:contentDescription="@string/choose_music"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:visibility="gone"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_music_library"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="20dp"
                app:iconTint="@color/action_button_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/musicPrevious"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/action_button_background"
                android:contentDescription="@string/previous_track"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:visibility="gone"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_previous"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="20dp"
                app:iconTint="@color/action_button_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/musicPlayPause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/action_button_background"
                android:contentDescription="@string/play"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:visibility="gone"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_play"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="20dp"
                app:iconTint="@color/action_button_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/musicNext"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/action_button_background"
                android:contentDescription="@string/next_track"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:visibility="gone"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_next"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="20dp"
                app:iconTint="@color/action_button_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/musicRandom"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/action_button_background"
                android:contentDescription="@string/random_next"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:visibility="gone"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_shuffle"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="20dp"
                app:iconTint="@color/action_button_text" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/upcomingSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="48dp"
            android:layout_marginBottom="@dimen/launcher_section_gap"
            android:clipChildren="false"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/upcomingAccent"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/accent_tick" />

                <TextView
                    android:id="@+id/upcomingTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.14"
                    android:text="@string/coming_next"
                    android:textAllCaps="true"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/upcomingCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:fontFamily="sans-serif-condensed"
                    android:textColor="@color/accent"
                    android:textSize="10sp" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/upcomingItems"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:layout_marginTop="@dimen/launcher_section_content_gap"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="false"
                android:overScrollMode="never" />

        </LinearLayout>

        <com.sergioasenjo.vesperhome.applications.AppRowView
            android:id="@+id/favoriteRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <com.sergioasenjo.vesperhome.applications.AppRowView
            android:id="@+id/applicationsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</FrameLayout>
