<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/wallpaper"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:tag="secondary"
            android:text="@string/wallpaper_description"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/timeBasedWallpaper"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/panel_row_background"
            android:gravity="start|center_vertical"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="14dp"
            android:textColor="@color/action_button_text"
            android:textSize="14sp"
            app:cornerRadius="8dp" />

        <LinearLayout
            android:id="@+id/mainWallpaperActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mainWallpaperStyle"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="@color/panel_row_background"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="14dp"
                android:textColor="@color/action_button_text"
                android:textSize="14sp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pickMainWallpaper"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="@color/panel_row_background"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="14dp"
                android:text="@string/pick_custom_wallpaper"
                android:textColor="@color/action_button_text"
                android:textSize="14sp"
                app:cornerRadius="8dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/scheduledWallpaperActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingHorizontal="14dp"
                android:letterSpacing="0.14"
                android:tag="accent"
                android:text="@string/day_wallpaper"
                android:textAllCaps="true"
                android:textColor="@color/accent"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dayWallpaperStyle"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="@color/panel_row_background"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="14dp"
                android:textColor="@color/action_button_text"
                android:textSize="14sp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pickDayWallpaper"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="@color/panel_row_background"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="14dp"
                android:text="@string/pick_custom_day_wallpaper"
                android:textColor="@color/action_button_text"
                android:textSize="14sp"
                app:cornerRadius="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingHorizontal="14dp"
                android:letterSpacing="0.14"
                android:tag="accent"
                android:text="@string/night_wallpaper"
                android:textAllCaps="true"
                android:textColor="@color/accent"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nightWallpaperStyle"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="@color/panel_row_background"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="14dp"
                android:textColor="@color/action_button_text"
                android:textSize="14sp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pickNightWallpaper"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="@color/panel_row_background"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="14dp"
                android:text="@string/pick_custom_night_wallpaper"
                android:textColor="@color/action_button_text"
                android:textSize="14sp"
                app:cornerRadius="8dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
