<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_background">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="52dp"
        android:paddingTop="32dp"
        android:paddingEnd="0dp"
        android:paddingBottom="34dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.18"
            android:tag="accent"
            android:text="@string/applications"
            android:textAllCaps="true"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/hidden_apps"
            android:textColor="@color/text_primary"
            android:textSize="31sp" />

        <TextView
            android:id="@+id/description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:tag="secondary"
            android:text="@string/hidden_apps_description"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <FrameLayout
            android:id="@+id/workspace"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="52dp"
            android:layout_weight="1"
            android:background="@drawable/management_workspace_background"
            android:clipChildren="false"
            android:paddingStart="22dp"
            android:paddingEnd="0dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/apps"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_gravity="center_vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="false"
                android:overScrollMode="never"
                android:paddingEnd="48dp" />

            <TextView
                android:id="@+id/emptyMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:tag="secondary"
                android:text="@string/no_hidden_apps"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

        </FrameLayout>

    </LinearLayout>

</FrameLayout>
