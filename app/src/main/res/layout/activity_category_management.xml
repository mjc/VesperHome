<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_background"
    android:paddingStart="56dp"
    android:paddingTop="44dp"
    android:paddingEnd="56dp"
    android:paddingBottom="44dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.01"
        android:text="@string/categories"
        android:textColor="@color/text_primary"
        android:textSize="32sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/categories_description"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/createCategory"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/action_button_background"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingHorizontal="20dp"
        android:text="@string/create_category"
        android:textColor="@color/action_button_text"
        app:cornerRadius="8dp"
        app:icon="@drawable/ic_add"
        app:iconPadding="10dp"
        app:iconSize="20dp"
        app:iconTint="@color/action_button_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/description" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/createSpacer"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginStart="12dp"
        android:backgroundTint="@color/action_button_background"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingHorizontal="20dp"
        android:text="@string/create_spacer"
        android:textColor="@color/action_button_text"
        app:cornerRadius="8dp"
        app:icon="@drawable/ic_add"
        app:iconPadding="10dp"
        app:iconSize="20dp"
        app:iconTint="@color/action_button_text"
        app:layout_constraintBottom_toBottomOf="@id/createCategory"
        app:layout_constraintStart_toEndOf="@id/createCategory"
        app:layout_constraintTop_toTopOf="@id/createCategory" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/categories"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/createCategory" />

    <TextView
        android:id="@+id/emptyMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/no_categories"
        android:textColor="@color/text_secondary"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/createCategory" />

</androidx.constraintlayout.widget.ConstraintLayout>
