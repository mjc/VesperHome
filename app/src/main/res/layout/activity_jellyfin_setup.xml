<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_background">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical"
        android:paddingStart="52dp"
        android:paddingTop="32dp"
        android:paddingEnd="52dp"
        android:paddingBottom="34dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:letterSpacing="0.18"
        android:text="@string/integrations"
        android:textAllCaps="true"
        android:textColor="@color/accent"
        android:textSize="11sp"
        android:tag="accent"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/media_services_setup"
        android:textColor="@color/text_primary"
        android:textSize="31sp" />

    <TextView
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/media_services_setup_description"
        android:textColor="@color/text_secondary"
        android:tag="secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:clipChildren="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="220dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingEnd="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.12"
                android:text="@string/connected_services"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:tag="secondary"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/showPlex"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:backgroundTint="@color/media_service_nav_background"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="16dp"
                android:text="@string/plex"
                android:textColor="@color/action_button_text"
                android:textSize="14sp"
                app:cornerRadius="11dp"
                app:icon="@drawable/ic_movie"
                app:iconPadding="12dp"
                app:iconSize="20dp"
                app:iconTint="@color/action_button_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/showJellyfin"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:backgroundTint="@color/media_service_nav_background"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="16dp"
                android:text="@string/jellyfin"
                android:textColor="@color/action_button_text"
                android:textSize="14sp"
                app:cornerRadius="11dp"
                app:icon="@drawable/ic_jellyfin"
                app:iconPadding="12dp"
                app:iconSize="20dp"
                app:iconTint="@color/action_button_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/showSonarr"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="7dp"
                android:backgroundTint="@color/media_service_nav_background"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="16dp"
                android:text="@string/sonarr"
                android:textColor="@color/action_button_text"
                android:textSize="14sp"
                app:cornerRadius="11dp"
                app:icon="@drawable/ic_tv_series"
                app:iconPadding="12dp"
                app:iconSize="20dp"
                app:iconTint="@color/action_button_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/showRadarr"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="7dp"
                android:backgroundTint="@color/media_service_nav_background"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="16dp"
                android:text="@string/radarr"
                android:textColor="@color/action_button_text"
                android:textSize="14sp"
                app:cornerRadius="11dp"
                app:icon="@drawable/ic_movie"
                app:iconPadding="12dp"
                app:iconSize="20dp"
                app:iconTint="@color/action_button_text" />

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="14dp"
                android:text="@string/media_services_hint"
                android:textColor="@color/text_secondary"
                android:tag="secondary"
                android:textSize="11sp" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipChildren="false">

            <include
                android:id="@+id/plexPage"
                layout="@layout/view_plex_service"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <include
                android:id="@+id/jellyfinPage"
                layout="@layout/view_jellyfin_service"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.sergioasenjo.vesperhome.upcoming.MediaServiceFormView
                android:id="@+id/sonarrPage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <com.sergioasenjo.vesperhome.upcoming.MediaServiceFormView
                android:id="@+id/radarrPage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

    </LinearLayout>

</FrameLayout>
