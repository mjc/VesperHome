<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/brightness_scheduler"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:tag="secondary"
            android:text="@string/brightness_scheduler_description"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/permissionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/configurePermission"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="@color/panel_row_background"
            android:gravity="start|center_vertical"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="14dp"
            android:text="@string/grant_brightness_permission"
            android:textColor="@color/action_button_text"
            android:textSize="14sp"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/enabled"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:backgroundTint="@color/panel_row_background"
            android:gravity="start|center_vertical"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="14dp"
            android:textColor="@color/action_button_text"
            android:textSize="14sp"
            app:cornerRadius="8dp" />

        <TextView
            android:id="@+id/currentPeriod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="14dp"
            android:letterSpacing="0.14"
            android:tag="accent"
            android:textAllCaps="true"
            android:textColor="@color/accent"
            android:textSize="11sp" />

        <include
            android:id="@+id/morningPeriod"
            layout="@layout/item_brightness_period" />

        <include
            android:id="@+id/dayPeriod"
            layout="@layout/item_brightness_period" />

        <include
            android:id="@+id/afternoonPeriod"
            layout="@layout/item_brightness_period" />

        <include
            android:id="@+id/eveningPeriod"
            layout="@layout/item_brightness_period" />

        <include
            android:id="@+id/nightPeriod"
            layout="@layout/item_brightness_period" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:paddingHorizontal="14dp"
            android:tag="secondary"
            android:text="@string/brightness_experimental_warning"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
