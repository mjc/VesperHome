<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@null"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="36dp"
    android:paddingTop="30dp"
    android:paddingEnd="36dp"
    android:paddingBottom="30dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:letterSpacing="0.16"
        android:text="@string/coming_next_integration"
        android:textAllCaps="true"
        android:textColor="@color/accent"
        android:textSize="11sp"
        android:tag="accent"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/text_primary"
        android:textSize="27sp" />

    <TextView
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:maxWidth="680dp"
        android:textColor="@color/text_secondary"
        android:tag="secondary"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/server_url"
        android:textColor="@color/text_secondary"
        android:tag="secondary"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/serverUrl"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/media_input_background"
        android:hint="@string/media_service_url_hint"
        android:imeOptions="actionNext"
        android:inputType="textUri"
        android:paddingHorizontal="15dp"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/api_key"
        android:textColor="@color/text_secondary"
        android:tag="secondary"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/apiKey"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/media_input_background"
        android:hint="@string/api_key"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        android:paddingHorizontal="15dp"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:backgroundTint="@color/action_button_background"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="20dp"
            android:text="@string/test_and_save"
            android:textColor="@color/action_button_text"
            app:cornerRadius="9dp"
            app:icon="@drawable/ic_connected"
            app:iconPadding="9dp"
            app:iconSize="18dp"
            app:iconTint="@color/action_button_text" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginStart="13dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="13dp"
            android:background="@drawable/media_status_background"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="13dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:tag="status"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
