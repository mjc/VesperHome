<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:paddingStart="36dp"
    android:paddingTop="28dp"
    android:paddingEnd="36dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/playback_integration"
        android:textAllCaps="true"
        android:textSize="11sp"
        android:tag="accent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/plex"
        android:textSize="27sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/plex_setup_description"
        android:textSize="13sp"
        android:tag="secondary" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:padding="14dp"
        android:textSize="13sp"
        android:tag="status" />

    <EditText
        android:id="@+id/serverUrl"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/media_input_background"
        android:hint="@string/plex_server_url_hint"
        android:inputType="textUri"
        android:paddingHorizontal="15dp"
        android:singleLine="true"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/accessToken"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/media_input_background"
        android:hint="@string/plex_access_token"
        android:inputType="textPassword"
        android:paddingHorizontal="15dp"
        android:singleLine="true"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/connectMusic"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/connect_plex_music"
            app:cornerRadius="9dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/disconnectMusic"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:text="@string/disconnect_jellyfin"
            android:visibility="gone"
            app:cornerRadius="9dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/useMusic"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:text="@string/use_plex_music"
            app:cornerRadius="9dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/musicStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textSize="13sp"
        android:tag="secondary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/usePlex"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:text="@string/use_plex_coming_next"
        app:cornerRadius="9dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/openPlex"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:text="@string/open_plex"
        app:cornerRadius="9dp" />

</LinearLayout>
</ScrollView>
