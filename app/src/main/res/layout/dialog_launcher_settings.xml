<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/settings_panel_background">

    <ScrollView
        android:id="@+id/mainPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/launcher_settings"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/homeStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/home_status_background"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:text="@string/home_status_checking"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/setDefaultLauncher"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/panel_row_background"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="14dp"
                android:text="@string/set_default_launcher"
                android:textColor="@color/action_button_text"
                android:textSize="14sp"
                android:visibility="gone"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_home"
                app:iconPadding="12dp"
                app:iconSize="18dp"
                app:iconTint="@color/action_button_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/homeButtonFix"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:backgroundTint="@color/panel_row_background"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="14dp"
                android:textColor="@color/action_button_text"
                android:textSize="14sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_accessibility"
                app:iconPadding="12dp"
                app:iconSize="18dp"
                app:iconTint="@color/action_button_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingHorizontal="14dp"
                android:tag="secondary"
                android:text="@string/home_button_fix_description"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingHorizontal="14dp"
                android:letterSpacing="0.14"
                android:tag="accent"
                android:text="@string/interface_settings"
                android:textAllCaps="true"
                android:textColor="@color/accent"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openAppearance"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="@color/panel_row_background"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="14dp"
                android:text="@string/appearance"
                android:textColor="@color/action_button_text"
                android:textSize="14sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_palette"
                app:iconPadding="12dp"
                app:iconSize="18dp"
                app:iconTint="@color/action_button_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openWallpaper"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="@color/panel_row_background"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="14dp"
                android:text="@string/wallpaper"
                android:textColor="@color/action_button_text"
                android:textSize="14sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_wallpaper"
                app:iconPadding="12dp"
                app:iconSize="18dp"
                app:iconTint="@color/action_button_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openStatusBar"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="@color/panel_row_background"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="14dp"
                android:text="@string/status_bar"
                android:textColor="@color/action_button_text"
                android:textSize="14sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_clock"
                app:iconPadding="12dp"
                app:iconSize="18dp"
                app:iconTint="@color/action_button_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openScreensaver"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="@color/panel_row_background"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="14dp"
                android:text="@string/screensaver_and_clock"
                android:textColor="@color/action_button_text"
                android:textSize="14sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_screensaver"
                app:iconPadding="12dp"
                app:iconSize="18dp"
                app:iconTint="@color/action_button_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openBrightness"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="@color/panel_row_background"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="14dp"
                android:text="@string/brightness_scheduler"
                android:textColor="@color/action_button_text"
                android:textSize="14sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_brightness"
                app:iconPadding="12dp"
                app:iconSize="18dp"
                app:iconTint="@color/action_button_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingHorizontal="14dp"
                android:letterSpacing="0.14"
                android:tag="accent"
                android:text="@string/applications"
                android:textAllCaps="true"
                android:textColor="@color/accent"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/manageCategories"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="@color/panel_row_background"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="14dp"
                android:text="@string/manage_categories"
                android:textColor="@color/action_button_text"
                android:textSize="14sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_category"
                app:iconPadding="12dp"
                app:iconSize="18dp"
                app:iconTint="@color/action_button_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/manageHiddenApps"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="@color/panel_row_background"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="14dp"
                android:text="@string/manage_hidden_apps"
                android:textColor="@color/action_button_text"
                android:textSize="14sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_hidden"
                app:iconPadding="12dp"
                app:iconSize="18dp"
                app:iconTint="@color/action_button_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sortApplications"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="@color/panel_row_background"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="14dp"
                android:text="@string/sort_applications"
                android:textColor="@color/action_button_text"
                android:textSize="14sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_sort"
                app:iconPadding="12dp"
                app:iconSize="18dp"
                app:iconTint="@color/action_button_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingHorizontal="14dp"
                android:letterSpacing="0.14"
                android:tag="accent"
                android:text="@string/integrations"
                android:textAllCaps="true"
                android:textColor="@color/accent"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/setupMediaServices"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="@color/panel_row_background"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="14dp"
                android:text="@string/media_services_setup"
                android:textColor="@color/action_button_text"
                android:textSize="14sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_media_services"
                app:iconPadding="12dp"
                app:iconSize="18dp"
                app:iconTint="@color/action_button_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/manageProfiles"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="@color/panel_row_background"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="14dp"
                android:text="@string/layout_profiles"
                android:textColor="@color/action_button_text"
                android:textSize="14sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_category"
                app:iconPadding="12dp"
                app:iconSize="18dp"
                app:iconTint="@color/action_button_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingHorizontal="14dp"
                android:letterSpacing="0.14"
                android:tag="accent"
                android:text="@string/system"
                android:textAllCaps="true"
                android:textColor="@color/accent"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backupAndRestore"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="@color/panel_row_background"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="14dp"
                android:text="@string/backup_and_restore"
                android:textColor="@color/action_button_text"
                android:textSize="14sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_backup"
                app:iconPadding="12dp"
                app:iconSize="18dp"
                app:iconTint="@color/action_button_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/aboutAndDiagnostics"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="@color/panel_row_background"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="14dp"
                android:text="@string/about_and_diagnostics"
                android:textColor="@color/action_button_text"
                android:textSize="14sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_info"
                app:iconPadding="12dp"
                app:iconSize="18dp"
                app:iconTint="@color/action_button_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openSystemSettings"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="@color/panel_row_background"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="14dp"
                android:text="@string/system_settings"
                android:textColor="@color/action_button_text"
                android:textSize="14sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_tune"
                app:iconPadding="12dp"
                app:iconSize="18dp"
                app:iconTint="@color/action_button_text" />

        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/appearancePage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/appearance"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:tag="secondary"
                android:text="@string/appearance_description"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/theme"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/panel_row_background"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="14dp"
                android:textColor="@color/action_button_text"
                android:textSize="14sp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/showAppNames"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="@color/panel_row_background"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="14dp"
                android:textColor="@color/action_button_text"
                android:textSize="14sp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/showCategoryTitles"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="@color/panel_row_background"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="14dp"
                android:textColor="@color/action_button_text"
                android:textSize="14sp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/showFocusOutline"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="@color/panel_row_background"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="14dp"
                android:textColor="@color/action_button_text"
                android:textSize="14sp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/appCardFocusAnimations"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="@color/panel_row_background"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="14dp"
                android:textColor="@color/action_button_text"
                android:textSize="14sp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/selectorTransitionAnimations"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="@color/panel_row_background"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="14dp"
                android:textColor="@color/action_button_text"
                android:textSize="14sp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/keyClickSounds"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="@color/panel_row_background"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="14dp"
                android:textColor="@color/action_button_text"
                android:textSize="14sp"
                app:cornerRadius="8dp" />

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/wallpaperPage"
        layout="@layout/view_wallpaper_settings"
        android:visibility="gone" />

    <include
        android:id="@+id/statusBarPage"
        layout="@layout/view_status_bar_settings"
        android:visibility="gone" />

    <include
        android:id="@+id/screensaverPage"
        layout="@layout/view_screensaver_settings"
        android:visibility="gone" />

    <include
        android:id="@+id/brightnessPage"
        layout="@layout/view_brightness_settings"
        android:visibility="gone" />
</FrameLayout>
