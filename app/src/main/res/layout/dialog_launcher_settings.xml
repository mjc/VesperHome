<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/settings_panel_background">

    <ScrollView
        android:id="@+id/mainPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="32dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/launcher_settings"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/homeStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/home_status_background"
                android:padding="16dp"
                android:text="@string/home_status_checking"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="@color/text_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/setDefaultLauncher"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/action_button_background"
                android:gravity="start|center_vertical"
                android:text="@string/set_default_launcher"
                android:textColor="@color/action_button_text"
                android:visibility="gone"
                app:cornerRadius="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:tag="secondary"
                android:text="@string/interface_settings"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openAppearance"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/action_button_background"
                android:gravity="start|center_vertical"
                android:text="@string/appearance"
                android:textColor="@color/action_button_text"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openWallpaper"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/action_button_background"
                android:gravity="start|center_vertical"
                android:text="@string/wallpaper"
                android:textColor="@color/action_button_text"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openStatusBar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/action_button_background"
                android:gravity="start|center_vertical"
                android:text="@string/status_bar"
                android:textColor="@color/action_button_text"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openScreensaver"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/action_button_background"
                android:gravity="start|center_vertical"
                android:text="@string/screensaver_and_clock"
                android:textColor="@color/action_button_text"
                app:cornerRadius="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:tag="secondary"
                android:text="@string/applications"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/manageCategories"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/action_button_background"
                android:gravity="start|center_vertical"
                android:text="@string/manage_categories"
                android:textColor="@color/action_button_text"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/manageHiddenApps"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/action_button_background"
                android:gravity="start|center_vertical"
                android:text="@string/manage_hidden_apps"
                android:textColor="@color/action_button_text"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sortApplications"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/action_button_background"
                android:gravity="start|center_vertical"
                android:text="@string/sort_applications"
                android:textColor="@color/action_button_text"
                app:cornerRadius="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:tag="secondary"
                android:text="@string/integrations"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/setupJellyfin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/action_button_background"
                android:gravity="start|center_vertical"
                android:text="@string/jellyfin_setup"
                android:textColor="@color/action_button_text"
                app:cornerRadius="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:tag="secondary"
                android:text="@string/system"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openSystemSettings"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/action_button_background"
                android:gravity="start|center_vertical"
                android:text="@string/system_settings"
                android:textColor="@color/action_button_text"
                app:cornerRadius="10dp" />

        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/appearancePage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="32dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/appearance"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:tag="secondary"
                android:text="@string/appearance_description"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/theme"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/action_button_background"
                android:gravity="start|center_vertical"
                android:textColor="@color/action_button_text"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/showAppNames"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/action_button_background"
                android:gravity="start|center_vertical"
                android:textColor="@color/action_button_text"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/showCategoryTitles"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/action_button_background"
                android:gravity="start|center_vertical"
                android:textColor="@color/action_button_text"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/showFocusOutline"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/action_button_background"
                android:gravity="start|center_vertical"
                android:textColor="@color/action_button_text"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/appCardFocusAnimations"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/action_button_background"
                android:gravity="start|center_vertical"
                android:textColor="@color/action_button_text"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/selectorTransitionAnimations"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/action_button_background"
                android:gravity="start|center_vertical"
                android:textColor="@color/action_button_text"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/keyClickSounds"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/action_button_background"
                android:gravity="start|center_vertical"
                android:textColor="@color/action_button_text"
                app:cornerRadius="10dp" />

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/wallpaperPage"
        layout="@layout/view_wallpaper_settings"
        android:visibility="gone" />

    <include
        android:id="@+id/statusBarPage"
        layout="@layout/view_status_bar_settings"
        android:visibility="gone" />

    <include
        android:id="@+id/screensaverPage"
        layout="@layout/view_screensaver_settings"
        android:visibility="gone" />
</FrameLayout>
